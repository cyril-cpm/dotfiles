color0  #1a1a1a
# Rouge (Brique/Terre pour contraster avec le jaune)
color1  #a63d40
# Vert (Sauge, pour rappeler le champ de colza)
color2  #2d5a27
# Jaune (Moutarde sombre, pour ne pas disparaître sur le blanc)
color3  #92400e
# Bleu (Bleu pétrole, pour le ciel)
color4  #1e3a8a
# Magenta (Prune)
color5  #7a4a8d
# Cyan (Turquoise profond)
color6  #0e7490
# Gris (Gris clair)
color7  #888888

# --- Les 8 couleurs vives (Plus de peps, mais toujours lisibles) ---
color8  #4d4d4d
color9  #d74e52
color10 #387132
color11 #b45309
color12 #2563eb
color13 #af7ac5
color14 #0891b2
color15 #000000

