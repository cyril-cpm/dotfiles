output "LG Display 0x0564 Unknown" {
	alias $builtin
}

profile tablet {
	output $builtin {
		enable
		position 0,0
		transform 180
		scale 1
	}
	exec echo tablet >> /tmp/kanshiProfile
	exec swaymsg "output $builtin bg /home/cpm/.config/sway/solar_H.jpg fill"
}

profile desktopDock {
	output $builtin {
		enable
		transform 90
		scale 1.25
		position 2600,0
	}
	output "Philips Consumer Electronics Company 227ELH AU31215002102" {
		enable
		transform normal
		scale 0.75
		position 0,0
	}
	exec echo desktopDock >> /tmp/kanshiProfile
	exec swaymsg output $builtin bg /home/cpm/.config/sway/solar_V.jpg fill
}
